datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password            String
  mobile              String?
  dob                 String?
  gender              String?
  isEmailVerified     Boolean  @default(true)
  isMobileVerified    Boolean  @default(false)
  nationality         String?
  preferredCurrency   String?  @default("₹")
  emergencyContactName String?
  emergencyContactPhone String?
  travelPreferences   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tripMembers         TripMember[]
  expensesPaid        Expense[]            @relation("PaidBy")
  createdExpenses     Expense[]            @relation("CreatedBy")
  expenseParticipants ExpenseParticipant[]
  createdTrips        Trip[]               @relation("TripCreatedBy")
  activities          Activity[]
  sentSettlements     Settlement[]         @relation("FromUser")
  receivedSettlements Settlement[]         @relation("ToUser")
  documents           UserDocument[]
  editRequests        ExpenseEditRequest[]
  pollsCreated        Poll[]                  @relation("CreatedPolls")
  pollVotes           PollVote[]
  walletAdvances        WalletAdvance[]      @relation("AdvanceUser")
  approvedAdvances      WalletAdvance[]      @relation("ApprovedAdvanceUser")
  walletTransactions    WalletTransaction[]  @relation("TransactionCreatedBy")
  userWallets           UserWallet[]
  locations             MemberLocation[]
}

model Trip {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  code         String    @unique
  currency     String    @default("₹")
  budget       Float?
  startDate    DateTime?
  endDate      DateTime?
  createdById  String?   @db.ObjectId
  isLocked     Boolean   @default(false)
  approvalMode Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy User?        @relation("TripCreatedBy", fields: [createdById], references: [id])
  members   TripMember[]
  expenses  Expense[]
  activities Activity[]
  settlements Settlement[]
  itinerary ItineraryItem[]
  stays     StayDetail[]
  polls     Poll[]
  locations MemberLocation[]
  userWallets UserWallet[]
}

model TripMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId   String   @db.ObjectId
  userId   String   @db.ObjectId
  role     String   @default("MEMBER") // ADMIN or MEMBER
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Expense {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId              String   @db.ObjectId
  title               String
  amount              Float
  category            String   @default("Miscellaneous")
  paidById            String   @db.ObjectId
  createdById         String?  @db.ObjectId
  lastUpdatedById     String?  @db.ObjectId
  status              String   @default("APPROVED") // APPROVED, PENDING_APPROVAL, or REJECTED
  paymentMode         String   @default("PERSONALLY") // PERSONALLY or WALLET
  walletTransactionId String?  @db.ObjectId
  rejectionReason     String?
  receiptUrl          String?
  date                DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trip               Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy             User                @relation("PaidBy", fields: [paidById], references: [id])
  createdBy          User?               @relation("CreatedBy", fields: [createdById], references: [id])
  participants       ExpenseParticipant[]
  editRequests       ExpenseEditRequest[]
  walletTransactions WalletTransaction[]

  @@index([tripId])
  @@index([paidById])
}

model ExpenseParticipant {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  expenseId   String @db.ObjectId
  userId      String @db.ObjectId
  shareAmount Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model Activity {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId     String   @db.ObjectId
  userId     String   @db.ObjectId
  actionType String   // TRIP_CREATED, MEMBER_JOINED, EXPENSE_ADDED, EXPENSE_UPDATED, EXPENSE_DELETED, EXPENSE_APPROVED, EXPENSE_REJECTED, EXPENSE_RESUBMITTED, EDIT_REQUEST_SUBMITTED, EDIT_REQUEST_APPROVED, EDIT_REQUEST_REJECTED, BUDGET_UPDATED, SETTLEMENT_MARKED, SETTLEMENT_CONFIRMED, TRIP_UPDATED, WALLET_ADVANCE_SUBMITTED, WALLET_ADVANCE_APPROVED, WALLET_ADVANCE_REJECTED
  details    String
  amount     Float?
  category   String?
  createdAt  DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}

model Settlement {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId     String   @db.ObjectId
  fromUserId String   @db.ObjectId
  toUserId   String   @db.ObjectId
  amount     Float
  status     String   @default("PENDING") // PENDING, CONFIRMED, REJECTED, COMPLETED, ROLLBACK_REQUESTED, ROLLED_BACK
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUser User @relation("FromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model UserWallet {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  tripId     String   @db.ObjectId
  balance    Float    @default(0)
  totalAdded Float    @default(0)
  totalSpent Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip         Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  advances     WalletAdvance[]
  transactions WalletTransaction[]

  @@unique([userId, tripId])
  @@index([tripId])
}

model WalletAdvance {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  walletId     String    @db.ObjectId
  userId       String    @db.ObjectId
  tripId       String    @db.ObjectId
  amount       Float
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  note         String?
  approvedById String?   @db.ObjectId
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wallet       UserWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user         User                @relation("AdvanceUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy   User?               @relation("ApprovedAdvanceUser", fields: [approvedById], references: [id])
  transactions WalletTransaction[]

  @@index([walletId])
  @@index([userId])
  @@index([tripId])
}

model WalletTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  walletId    String   @db.ObjectId
  type        String   // ADVANCE_CREDIT, EXPENSE_DEBIT, REFUND, ADJUSTMENT
  amount      Float
  description String?
  expenseId   String?  @db.ObjectId
  advanceId   String?  @db.ObjectId
  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())

  wallet    UserWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  expense   Expense?       @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  advance   WalletAdvance? @relation(fields: [advanceId], references: [id], onDelete: SetNull)
  createdBy User           @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([walletId])
}

model ExpenseEditRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseId     String   @db.ObjectId
  tripId        String   @db.ObjectId
  requestedById String   @db.ObjectId
  requestType   String   @default("EDIT") // EDIT, DELETE
  proposedData  String?
  reason        String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  requestedBy User    @relation(fields: [requestedById], references: [id], onDelete: Cascade)
}

model UserDocument {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  tripId       String?  @db.ObjectId
  documentType String   // AADHAAR, PASSPORT, DRIVING_LICENSE, PAN, OTHER
  idNumber     String?
  documentUrl  String
  isVerified   Boolean  @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ItineraryItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String   @db.ObjectId
  dayNumber   Int
  date        DateTime?
  title       String
  description String?
  location    String?
  startTime   String?
  endTime     String?
  category    String?  @default("General")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, dayNumber])
}

model StayDetail {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId       String   @db.ObjectId
  name         String
  address      String?
  checkIn      DateTime?
  checkOut     DateTime?
  checkInTime  String?
  checkOutTime String?
  bookingRef   String?
  bookingUrl   String?
  contactPhone String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Poll {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String   @db.ObjectId
  createdById String   @db.ObjectId
  question    String
  category    String?  @default("General") // Restaurant, Activity, Departure Time, Destination, General
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User         @relation("CreatedPolls", fields: [createdById], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]

  @@index([tripId])
}

model PollOption {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  pollId String @db.ObjectId
  text   String

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  pollId    String   @db.ObjectId
  optionId  String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model MemberLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId    String   @db.ObjectId
  userId    String   @db.ObjectId
  latitude  Float
  longitude Float
  accuracy  Float?
  isSharing Boolean  @default(true)
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

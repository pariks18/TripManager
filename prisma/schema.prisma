datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password            String
  mobile              String?
  dob                 String?
  gender              String?
  isEmailVerified     Boolean  @default(true)
  isMobileVerified    Boolean  @default(false)
  recoveryEmail       String?
  isRecoveryEmailVerified Boolean @default(false)
  nationality         String?
  preferredCurrency   String?  @default("₹")
  emergencyContactName String?
  emergencyContactPhone String?
  travelPreferences   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tripMembers         TripMember[]
  expensesPaid        Expense[]            @relation("PaidBy")
  createdExpenses     Expense[]            @relation("CreatedBy")
  expenseParticipants ExpenseParticipant[]
  createdTrips        Trip[]               @relation("TripCreatedBy")
  activities          Activity[]
  sentSettlements     Settlement[]         @relation("FromUser")
  receivedSettlements Settlement[]         @relation("ToUser")
  documents           UserDocument[]
  editRequests        ExpenseEditRequest[]
  pollsCreated        Poll[]                  @relation("CreatedPolls")
  pollVotes           PollVote[]
  locations             MemberLocation[]
  otpVerifications      OtpVerification[]
  sentMessages          Message[]            @relation("MessageSender")
  memories              TripMemory[]         @relation("MemoryAuthor")
  sentMemoryShares      MemoryShareRequest[] @relation("MemoryShareOwner")
  receivedMemoryShares  MemoryShareRequest[] @relation("MemoryShareTarget")
}

model Trip {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  code         String    @unique
  currency     String    @default("₹")
  budget       Float?
  startDate    DateTime?
  endDate      DateTime?
  createdById  String?   @db.ObjectId
  isLocked     Boolean   @default(false)
  approvalMode Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy User?        @relation("TripCreatedBy", fields: [createdById], references: [id])
  members   TripMember[]
  expenses  Expense[]
  activities Activity[]
  settlements Settlement[]
  itinerary ItineraryItem[]
  stays     StayDetail[]
  polls     Poll[]
  locations MemberLocation[]
  messages  Message[]
  memories  TripMemory[]
}

model TripMember {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  tripId     String    @db.ObjectId
  userId     String    @db.ObjectId
  role       String    @default("MEMBER") // ADMIN or MEMBER
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Expense {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId          String   @db.ObjectId
  title           String
  amount          Float
  category        String   @default("Miscellaneous")
  paidById        String   @db.ObjectId
  createdById     String?  @db.ObjectId
  lastUpdatedById String?  @db.ObjectId
  status          String   @default("APPROVED") // APPROVED, PENDING_APPROVAL, or REJECTED
  rejectionReason String?
  receiptUrl      String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trip         Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy       User                 @relation("PaidBy", fields: [paidById], references: [id])
  createdBy    User?                @relation("CreatedBy", fields: [createdById], references: [id])
  participants ExpenseParticipant[]
  editRequests ExpenseEditRequest[]

  @@index([tripId])
  @@index([paidById])
}

model ExpenseParticipant {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  expenseId   String @db.ObjectId
  userId      String @db.ObjectId
  shareAmount Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model Activity {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId     String   @db.ObjectId
  userId     String   @db.ObjectId
  actionType String   // TRIP_CREATED, MEMBER_JOINED, EXPENSE_ADDED, EXPENSE_UPDATED, EXPENSE_DELETED, EXPENSE_APPROVED, EXPENSE_REJECTED, EXPENSE_RESUBMITTED, EDIT_REQUEST_SUBMITTED, EDIT_REQUEST_APPROVED, EDIT_REQUEST_REJECTED, BUDGET_UPDATED, SETTLEMENT_MARKED, SETTLEMENT_CONFIRMED, TRIP_UPDATED
  details    String
  amount     Float?
  category   String?
  createdAt  DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}

model Settlement {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId          String   @db.ObjectId
  fromUserId      String   @db.ObjectId
  toUserId        String   @db.ObjectId
  amount          Float
  settledAmount   Float    @default(0)
  remainingAmount Float?
  status          String   @default("PENDING") // PENDING, PARTIALLY_SETTLED, SETTLED, CONFIRMED, REJECTED, COMPLETED, PENDING_REVERSAL, REVERSAL_DECLINED_PENDING_HOST, REVERSED, REVERSAL_REJECTED
  note            String?

  // Reversal Audit Trail
  reversalReason            String?
  reversalProofUrl          String?
  reversalRequestedById     String?
  reversalRequestedAt       DateTime?
  reversalRecipientDecision String? // ACCEPTED, DECLINED
  reversalRecipientReason   String?
  reversalRecipientProofUrl String?
  reversalHostDecision      String? // APPROVED_OVERRIDE, REJECTED
  reversalHostReason        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUser User @relation("FromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model ExpenseEditRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseId     String   @db.ObjectId
  tripId        String   @db.ObjectId
  requestedById String   @db.ObjectId
  requestType   String   @default("EDIT") // EDIT, DELETE
  proposedData  String?
  reason        String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  requestedBy User    @relation(fields: [requestedById], references: [id], onDelete: Cascade)
}

model UserDocument {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  tripId       String?  @db.ObjectId
  documentType String   // AADHAAR, PASSPORT, DRIVING_LICENSE, PAN, OTHER
  idNumber     String?
  documentUrl  String
  isVerified   Boolean  @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ItineraryItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String   @db.ObjectId
  dayNumber   Int
  date        DateTime?
  title       String
  description String?
  location    String?
  startTime   String?
  endTime     String?
  category    String?  @default("General")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, dayNumber])
}

model StayDetail {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId       String   @db.ObjectId
  name         String
  address      String?
  checkIn      DateTime?
  checkOut     DateTime?
  checkInTime  String?
  checkOutTime String?
  bookingRef   String?
  bookingUrl   String?
  contactPhone String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Poll {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String   @db.ObjectId
  createdById String   @db.ObjectId
  question    String
  category    String?  @default("General") // Restaurant, Activity, Departure Time, Destination, General
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User         @relation("CreatedPolls", fields: [createdById], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]

  @@index([tripId])
}

model PollOption {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  pollId String @db.ObjectId
  text   String

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  pollId    String   @db.ObjectId
  optionId  String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model MemberLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId    String   @db.ObjectId
  userId    String   @db.ObjectId
  latitude  Float
  longitude Float
  accuracy  Float?
  isSharing Boolean  @default(true)
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model OtpVerification {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  phoneNumber String?
  purpose     String    // 'PHONE_REGISTRATION' | 'PHONE_CHANGE' | 'PASSWORD_CHANGE'
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  verifiedAt  DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId    String   @db.ObjectId
  senderId  String   @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}

model TripMemory {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId            String   @db.ObjectId
  userId            String   @db.ObjectId
  dayNumber         Int
  date              DateTime?
  title             String?
  type              String   @default("PERSONAL") // "PERSONAL" or "GROUP"
  answers           String?  // JSON stringified object for questionnaire answers
  freeText          String?
  photos            String[] @default([])
  privacy           String   @default("PRIVATE") // "PRIVATE", "SHARED_SELECTIVE", "SHARED_GROUP"
  sharedWithUserIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trip          Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user          User                 @relation("MemoryAuthor", fields: [userId], references: [id], onDelete: Cascade)
  shareRequests MemoryShareRequest[]

  @@index([tripId, dayNumber])
  @@index([userId, tripId])
}

model MemoryShareRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  memoryId     String   @db.ObjectId
  ownerId      String   @db.ObjectId
  targetUserId String   @db.ObjectId
  status       String   @default("PENDING") // "PENDING", "ACCEPTED", "DECLINED"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memory     TripMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  owner      User       @relation("MemoryShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetUser User       @relation("MemoryShareTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([memoryId, targetUserId])
  @@index([targetUserId, status])
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripMembers         TripMember[]
  expensesPaid        Expense[]            @relation("PaidBy")
  createdExpenses     Expense[]            @relation("CreatedBy")
  expenseParticipants ExpenseParticipant[]
  createdTrips        Trip[]               @relation("TripCreatedBy")
  activities          Activity[]
  sentSettlements     Settlement[]         @relation("FromUser")
  receivedSettlements Settlement[]         @relation("ToUser")
  documents           UserDocument[]
  editRequests        ExpenseEditRequest[]
  advanceContributions AdvanceContribution[] @relation("UserAdvanceContributions")
  walletTransactions WalletTransaction[]     @relation("CreatedWalletTransactions")
}

model Trip {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  code         String    @unique
  currency     String    @default("₹")
  budget       Float?
  startDate    DateTime?
  endDate      DateTime?
  createdById  String?   @db.ObjectId
  isLocked     Boolean   @default(false)
  approvalMode Boolean   @default(false)
  advanceTargetPerMember Float?
  requireAdvanceVerification Boolean @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy User?        @relation("TripCreatedBy", fields: [createdById], references: [id])
  members   TripMember[]
  expenses  Expense[]
  activities Activity[]
  settlements Settlement[]
  itinerary ItineraryItem[]
  stays     StayDetail[]
  advanceContributions AdvanceContribution[]
  walletTransactions WalletTransaction[]
}

model TripMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId   String   @db.ObjectId
  userId   String   @db.ObjectId
  role     String   @default("MEMBER") // ADMIN or MEMBER
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Expense {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId          String   @db.ObjectId
  title           String
  amount          Float
  category        String   @default("Miscellaneous")
  paidById        String   @db.ObjectId
  createdById     String?  @db.ObjectId
  lastUpdatedById String?  @db.ObjectId
  status          String   @default("APPROVED") // APPROVED, PENDING_APPROVAL, or REJECTED
  rejectionReason String?
  receiptUrl      String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trip         Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy       User                 @relation("PaidBy", fields: [paidById], references: [id])
  createdBy    User?                @relation("CreatedBy", fields: [createdById], references: [id])
  participants ExpenseParticipant[]
  editRequests ExpenseEditRequest[]
}

model ExpenseParticipant {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  expenseId   String @db.ObjectId
  userId      String @db.ObjectId
  shareAmount Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model Activity {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId     String   @db.ObjectId
  userId     String   @db.ObjectId
  actionType String   // TRIP_CREATED, MEMBER_JOINED, EXPENSE_ADDED, EXPENSE_UPDATED, EXPENSE_DELETED, EXPENSE_APPROVED, EXPENSE_REJECTED, EXPENSE_RESUBMITTED, EDIT_REQUEST_SUBMITTED, EDIT_REQUEST_APPROVED, EDIT_REQUEST_REJECTED, BUDGET_UPDATED, SETTLEMENT_MARKED, SETTLEMENT_CONFIRMED, TRIP_UPDATED
  details    String
  amount     Float?
  category   String?
  createdAt  DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settlement {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId     String   @db.ObjectId
  fromUserId String   @db.ObjectId
  toUserId   String   @db.ObjectId
  amount     Float
  status     String   @default("PENDING") // PENDING, CONFIRMED, REJECTED, COMPLETED
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUser User @relation("FromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ToUser", fields: [toUserId], references: [id], onDelete: Cascade)
}

model UserDocument {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  documentType String   // AADHAAR, PAN, VOTER_ID, DRIVING_LICENSE, PASSPORT, OTHER
  documentNo   String?
  fileUrl      String
  fileName     String?
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType])
}

model ExpenseEditRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseId     String   @db.ObjectId
  requestedById String   @db.ObjectId
  requestType   String   // EDIT or DELETE
  proposedData  String?  // JSON string
  reason        String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  requestedBy User    @relation(fields: [requestedById], references: [id], onDelete: Cascade)
}

model ItineraryItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String    @db.ObjectId
  dayNumber   Int       @default(1)
  date        DateTime?
  title       String
  description String?
  location    String?
  startTime   String?
  endTime     String?
  category    String?   // Sightseeing, Dining, Transport, Leisure, Activity, Flight
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model StayDetail {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  tripId       String    @db.ObjectId
  name         String
  address      String?
  checkIn      DateTime?
  checkOut     DateTime?
  checkInTime  String?
  checkOutTime String?
  bookingRef   String?
  bookingUrl   String?
  contactPhone String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model AdvanceContribution {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId          String   @db.ObjectId
  userId          String   @db.ObjectId
  amount          Float
  utr             String?
  screenshotUrl   String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation("UserAdvanceContributions", fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String   @db.ObjectId
  createdById String   @db.ObjectId
  title       String
  amount      Float
  category    String   @default("Miscellaneous")
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation("CreatedWalletTransactions", fields: [createdById], references: [id], onDelete: Cascade)
}


